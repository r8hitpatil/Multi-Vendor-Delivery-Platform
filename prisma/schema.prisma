datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  previewFeatures = ["views"]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  DRIVER
  CUSTOMER
}

enum Status {
  REJECTED
  PENDING
  ACCEPTED
}

enum OrderStatus {
  RECIEVED
  IN_TRANSIT
  REACHED
  OUT_OF_DELIVERY
  COMPLETED
}

model User {
  id String @id @default(uuid())
  name String
  phone String @unique
  email String @unique
  password String
  Role Role @default(CUSTOMER)

  aadhar String? @unique
  pan String? @unique
  ban Boolean @default(false)
  status Status @default(PENDING)

  adminId String? // this must be adminVendorId not adminId wrong annotation
  admin   User?   @relation("AdminVendors", fields: [adminId], references: [id])
  vendors User[]  @relation("AdminVendors")

  adminDriverId String?
  adminDriver User? @relation("AdminDrivers", fields: [adminDriverId],references: [id])
  drivers User[] @relation("AdminDrivers")

  orders Order[]
  driverOrders OrderItem[] @relation("DriverOrderItems")
  companyId String?
  company Company? @relation(fields: [companyId], references: [id])
  
  store Store?
  address Address?
  cart Cart?
}

model Company {
  id String @id @default(uuid())
  companyName String @unique
  about String

  addressId String @unique
  address Address @relation(fields: [addressId],references: [id])

  user User[]
}

model Address {
  id String @id @default(uuid())
  address String
  pin_code Int
  lat String
  long String

  userId String? @unique
  user User? @relation(fields: [userId],references: [id])
  company Company?
}

model Store {
  id String @id @default(uuid())
  vendorId String @unique
  vendor User @relation(fields: [vendorId],references: [id])
  products Product[]
  address StoreAddress?
}

model StoreAddress {
  id String @id @default(uuid())
  storeName String @unique
  storeAddress String @unique
  lat String
  long String

  storeId String @unique
  store Store @relation(fields: [storeId],references: [id])
}

model Order {
  id String @id @default(uuid())
  customerId String

  customer User @relation(fields: [customerId],references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id String @id @default(uuid())
  orderStatus OrderStatus @default(IN_TRANSIT)
  quantity Int
  orderId String
  order Order @relation(fields: [orderId],references: [id])

  productId String
  product Product @relation(fields: [productId],references: [id])
  price Int
  driverId String?
  driver User? @relation("DriverOrderItems", fields: [driverId],references: [id])
}

model Product {
  id String @id @default(uuid())
  name String
  quantity Int
  price Int
  discountedPrice Int?
  storeId String
  storeProducts Store @relation(fields: [storeId],references: [id])

  orderItem OrderItem[]
  cartItems CartItems[]
}

view AvailableProduct {
  id String @unique
  name String
  quantity Int
  price Int
  discountedPrice Int?
  storeId String
  storeName String?
  isAvailable Boolean
}

model Cart {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId],references: [id])
  items CartItems[]
}

model CartItems {
  id String @id @default(uuid())
  cartId String
  cart Cart @relation(fields: [cartId],references: [id])

  productId String
  product Product @relation(fields: [productId],references: [id])

  quantity Int @default(1)
  @@unique([cartId,productId]) // composite key
}