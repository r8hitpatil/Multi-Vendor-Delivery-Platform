datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  DRIVER
  CUSTOMER
}

enum Status {
  REJECTED
  PENDING
  ACCEPTED
}

enum OrderStatus {
  RECIEVED
  IN_TRANSIT
  REACHED
  OUT_OF_DELIVERY
  COMPLETED
}

model User {
  id String @unique @default(uuid())
  name String
  phone Int @unique
  email String @unique
  password String
  Role Role @default(CUSTOMER)

  companyName String @unique

  ban Boolean

  status Status @default(PENDING)

  orders Order[]
  storeOrders OrderItem[] @relation("VendorOrderItems")
  driverOrders OrderItem[] @relation("DriverOrderItems")
  stores Store?
  address Address[]
}

model Address {
  id String @unique @default(uuid())
  address String
  pin_code Int
  lat String
  long String

  userId String
  storeId String 

  user User @relation(fields: [userId],references: [id])
}


model Store {
  id String @unique @default(uuid())
  vendorId String @unique
  vendor User @relation(fields: [vendorId],references: [id])
  products Product[]
  orderItem OrderItem[]
  address StoreAddress?
}

model StoreAddress {
  id String @unique @default(uuid())
  storeName String @unique
  storeAddress String @unique
  lat String
  long String

  storeId String @unique
  store Store @relation(fields: [storeId],references: [id])
}

model Order {
  id String @unique @default(uuid())
  customerId String
  driverId String

  customer User @relation(fields: [customerId],references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id String @unique @default(uuid())
  orderStatus OrderStatus

  orderId String
  order Order @relation(fields: [orderId],references: [id])

  productId String
  product Product @relation(fields: [productId],references: [id])

  storeId String
  store Store @relation(fields: [storeId], references: [id])

  vendorId String
  vendor User @relation("VendorOrderItems", fields: [vendorId],references: [id])

  driverId String
  driver User @relation("DriverOrderItems", fields: [driverId],references: [id])
}

model Product {
  id String @unique @default(uuid())
  name String @unique
  quantity Int

  storeId String
  storeProducts Store @relation(fields: [storeId],references: [id])

  orderItem OrderItem[]
}